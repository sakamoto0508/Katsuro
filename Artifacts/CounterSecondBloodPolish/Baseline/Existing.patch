+        if (Vector3.Dot(tangent, slash) < 0f) tangent = -tangent;
+        offset = Vector3.ClampMagnitude(offset, .1f);
+        return point + tangent * offset.x + Vector3.up * offset.y + forward * offset.z;
+    }
